# Firebase設定
# 各環境変数を自分のFirebaseプロジェクトの設定値で置き換えてください
# このファイルをコピーして .env という名前で保存し、実際の値を設定してください

# Firebase API Key
REACT_APP_FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain
# ※ Google OAuth のリダイレクト URI (https://<authDomain>/__/auth/handler) は
# Google Cloud Console の「承認済みのリダイレクト URI」に登録されている必要があります。
# 通常は Firebase のデフォルトである <project-id>.firebaseapp.com を指定します。
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# 現在のオリジン/ホスト名を authDomain として採用する場合に 'true' を指定（iOS Safari の ITP 対策等）
# ※ 有効にする場合は、事前に Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs) で
# 「承認済みのリダイレクト URI」に https://<your-domain>/__/auth/handler を追加してください。未追加の場合 redirect_uri_mismatch エラーになります。
# REACT_APP_USE_CURRENT_ORIGIN_FOR_AUTH=false

# Firebase Project ID
REACT_APP_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID
REACT_APP_FIREBASE_APP_ID=your_app_id

# Firebase Measurement ID (Google Analytics)
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id
